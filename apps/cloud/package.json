{
  "name": "@runory/cloud",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-resources.mjs",
    "dev": "next dev --port 3000",
    "prebuild": "node scripts/sync-resources.mjs",
    "build": "next build",
    "pretest": "node scripts/sync-resources.mjs",
    "start": "next start --port 3000",
    "clean": "rm -rf .next .next-dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e:browser": "playwright test",
    "db:status": "node scripts/db-status.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "contracts:repair": "tsx scripts/repair-command-contracts.mjs",
    "contracts:sync-permissions": "tsx scripts/sync-pack-permission-groups.mjs",
    "avatars:generate": "node scripts/generate-demo-avatars.mjs",
    "bootstrap:demo": "node scripts/bootstrap-demo.mjs",
    "stripe:billing:setup": "node --env-file=.env.local scripts/stripe-billing-local.mjs setup",
    "stripe:billing:verify": "node --env-file=.env.local scripts/stripe-billing-local.mjs verify",
    "stripe:payments:setup": "pnpm exec tsx --env-file=.env.local scripts/stripe-payments-local.mjs setup",
    "stripe:payments:verify": "pnpm exec tsx --env-file=.env.local scripts/stripe-payments-local.mjs verify",
    "dev:stripe": "node --env-file=.env.local scripts/stripe-billing-dev.mjs",
    "db:backup": "tsx scripts/database-backup.mts backup",
    "db:restore": "tsx scripts/database-backup.mts restore",
    "db:recovery:drill": "tsx scripts/database-backup.mts drill"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@radix-ui/react-avatar": "^1.3.1",
    "@runory/contracts": "workspace:*",
    "@runory/platform-core": "workspace:*",
    "@vercel/blob": "^2.9.0",
    "lucide-react": "^1.78.0",
    "maplibre-gl": "^5.24.1",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^22.6.2",
    "swr": "^2.5.1",
    "web-vitals": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dicebear/core": "9.4.2",
    "@dicebear/notionists-neutral": "9.4.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
