        "ownership": "workspace_extension",
        "required": true,
        "default_value": "false",
        "ui": {
          "listColumn": true,
          "slot": "service_visit.service_visit_form",
          "order": 20
        }
      },
      {
        "targetObject": "service_visit",
        "fieldKey": "safety_confirmed",
        "label": "Site Safety Confirmed",
        "type": "boolean",
        "ownership": "workspace_extension",
        "required": true,
        "default_value": "false",
        "ui": {
          "listColumn": false,
          "slot": "service_visit.service_visit_form",
          "order": 30
        }
      }
    ]
  }
}
